# Ascendia AI — Environment Variables
# Copy this file to .env (root) and .env.local (frontend/) and fill in actual values.
# NEVER commit .env or .env.local.

# ─── Backend ────────────────────────────────────────────────
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ascendia

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=10

# Local upload storage directory (relative to backend/)
UPLOAD_DIR=uploads

# Application environment: development | staging | production
APP_ENV=development

# ─── Frontend ────────────────────────────────────────────────
# Base URL of the FastAPI backend (used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── AI Pipeline (Phase 2 — leave blank for Phase 1) ─────────
# AI_API_KEY=
# AI_MODEL=
